# Copy this file to .env.local and fill in your own Supabase project values.
# Both variables below are SAFE to expose to the browser (they are public by design):
# the anon/publishable key only ever grants access permitted by Row Level Security.
#
# NEVER put a service_role / secret key in this file or in any VITE_* variable.
# Service-role access belongs only in Supabase Edge Function secrets.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
